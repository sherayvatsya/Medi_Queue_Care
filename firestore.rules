rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read on live doctors, announcements, and queue tokens for kiosk & patient displays
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if true;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    match /patients/{patientId} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /wheelchairs/{requestId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
